    def setup_effects_overlay(self):
        self.TRANSPARENT_KEY = "#ff00ff"
        self.overlay = tk.Toplevel(self)
        self.overlay.overrideredirect(True)
        self.overlay.transient(self)
        self.overlay.configure(bg=self.TRANSPARENT_KEY)
        self.overlay.attributes("-transparentcolor", self.TRANSPARENT_KEY)

        self.fx_canvas = tk.Canvas(
            self.overlay, bg=self.TRANSPARENT_KEY, highlightthickness=0, bd=0
        )
        self.fx_canvas.pack(fill="both", expand=True)

        self.overlay_geometry = ""
        self.overlay_visible = True
        self.click_through_ok = False
        self.last_spawn = 0.0
        self.after(200, self.make_overlay_click_through)

    def make_overlay_click_through(self):
        try:
            self.overlay.update_idletasks()
            user32 = ctypes.windll.user32
            wid = self.overlay.winfo_id()
            hwnd = user32.GetParent(wid) or wid
            GWL_EXSTYLE = -20
            WS_EX_LAYERED = 0x00080000
            WS_EX_TRANSPARENT = 0x00000020
            WS_EX_NOACTIVATE = 0x08000000
            style = user32.GetWindowLongW(hwnd, GWL_EXSTYLE)
            user32.SetWindowLongW(
                hwnd, GWL_EXSTYLE,
                style | WS_EX_LAYERED | WS_EX_TRANSPARENT | WS_EX_NOACTIVATE
            )
            self.click_through_ok = True
        except Exception:
            self.click_through_ok = False

    def sync_overlay(self):
        if self.state() in ("iconic", "withdrawn"):
            if self.overlay_visible:
                self.overlay.withdraw()
                self.overlay_visible = False
            return

        if not self.overlay_visible:
            self.overlay.deiconify()
            self.overlay_visible = True
            self.overlay_geometry = ""

        geo = (
            f"{self.winfo_width()}x{self.winfo_height()}"
            f"+{self.winfo_rootx()}+{self.winfo_rooty()}"
        )
        if geo != self.overlay_geometry:
            self.overlay.geometry(geo)
            self.overlay.lift()
            self.overlay_geometry = geo

    def spawn_spark_particle(self, x, y, speed_min=1.0, speed_max=2.5, size_max=3):
        angle = random.uniform(0, 2 * math.pi)
        speed = random.uniform(speed_min, speed_max)
        dx = math.cos(angle) * speed
        dy = math.sin(angle) * speed
        size = random.randint(1, size_max)

        if not self.click_through_ok:
            x += math.cos(angle) * 10
            y += math.sin(angle) * 10

        p_id = self.fx_canvas.create_oval(
            x - size, y - size,
            x + size, y + size,
            fill="#111111", outline=""
        )
        self.particles.append({
            "id": p_id, "x": x, "y": y,
            "dx": dx, "dy": dy,
            "born": time.perf_counter(),
            "life": random.randint(6, 10) * 0.03
        })

    def spawn_click_ripple(self, event):
        x = event.x_root - self.winfo_rootx()
        y = event.y_root - self.winfo_rooty()
        self.add_ring(x, y, max_r=26, dur=0.45, w0=2)

    def add_ring(self, x, y, max_r, dur, w0):
        try:
            r_id = self.fx_canvas.create_oval(
                x - 2, y - 2, x + 2, y + 2,
                outline="#111111", width=w0
            )
        except tk.TclError:
            return
        self.ripples.append({
            "id": r_id, "x": x, "y": y,
            "born": time.perf_counter(),
            "dur": dur, "max_r": max_r, "w0": w0
        })

    def animate_effects(self):
        t0 = time.perf_counter()
        try:
            self.sync_overlay()
        except Exception:
            pass

        try:
            rel_x = self.winfo_pointerx() - self.winfo_rootx()
            rel_y = self.winfo_pointery() - self.winfo_rooty()
            inside = 0 <= rel_x <= self.winfo_width() and 0 <= rel_y <= self.winfo_height()

            if inside and self.overlay_visible and (t0 - self.last_spawn) >= 0.03:
                self.last_spawn = t0
                curr_pos = (rel_x, rel_y)
                if curr_pos != self.last_mouse_pos:
                    for _ in range(2):
                        self.spawn_spark_particle(rel_x, rel_y, speed_min=1.2, speed_max=2.8, size_max=3)
                    self.last_mouse_pos = curr_pos
                else:
                    if random.random() < 0.35:
                        self.spawn_spark_particle(rel_x, rel_y, speed_min=0.3, speed_max=1.0, size_max=2)
        except Exception:
            pass

        now = time.perf_counter()

        new_particles = []
        for p in self.particles:
            age = now - p["born"]
            if age < p["life"]:
                steps = age / 0.03
                px = p["x"] + p["dx"] * steps
                py = p["y"] + p["dy"] * steps
                self.fx_canvas.coords(p["id"], px - 2, py - 2, px + 2, py + 2)
                new_particles.append(p)
            else:
                self.fx_canvas.delete(p["id"])
        self.particles = new_particles

        new_ripples = []
        for r in self.ripples:
            t = (now - r["born"]) / r["dur"]
            if t < 1.0:
                ease = 1 - (1 - t) ** 3
                radius = 3 + (r["max_r"] - 3) * ease
                color = lerp_color("#111111", self.BG_COLOR, t)
                self.fx_canvas.coords(
                    r["id"],
                    r["x"] - radius, r["y"] - radius,
                    r["x"] + radius, r["y"] + radius
                )
                self.fx_canvas.itemconfigure(r["id"], outline=color)
                new_ripples.append(r)
            else:
                self.fx_canvas.delete(r["id"])
        self.ripples = new_ripples

        try:
            elapsed_ms = (time.perf_counter() - t0) * 1000
            self.after(max(1, int(16 - elapsed_ms)), self.animate_effects)
        except tk.TclError:
            pass

    # --- منطق التحويل والعمليات ---
    def select_file(self):
        filetypes = [
            ("All Supported Files", "*.png *.jpg *.jpeg *.webp *.bmp *.gif *.ico *.mp4 *.mov *.avi *.mkv *.mp3 *.wav *.flac *.aac *.m4a"),
            ("Image Files", "*.png *.jpg *.jpeg *.webp *.bmp *.gif *.ico"),
            ("Video Files", "*.mp4 *.mov *.avi *.mkv *.webm"),
            ("Audio Files", "*.mp3 *.wav *.flac *.aac *.m4a")
        ]
        path = filedialog.askopenfilename(filetypes=filetypes)
        if path:
            self.file_path = path
            self.src_ext = os.path.splitext(path)[1].lower()
            self.lbl_file.configure(text=f"Selected: {os.path.basename(path)}", text_color="#FFFFFF")
            self.btn_select.configure(text="Change File")
            self.update_format_options(self.src_ext)
            self.btn_convert.configure(state="normal")
            self.progress.set(0)
            self.lbl_status.configure(text="")
            self.hide_inline_alert()

    def update_format_options(self, ext):
        image_exts = ['.png', '.jpg', '.jpeg', '.webp', '.bmp', '.gif', '.ico']
        video_exts = ['.mp4', '.mov', '.avi', '.mkv', '.webm']
        audio_exts = ['.mp3', '.wav', '.flac', '.aac', '.m4a']

        options = []
        if ext in image_exts:
            targets = [e.strip('.').upper() for e in image_exts if e != ext]
            options = [f"to {t}" for t in targets]
        elif ext in video_exts:
            video_targets = [e.strip('.').upper() for e in video_exts if e != ext]
            audio_targets = [e.strip('.').upper() for e in audio_exts]
            options = [f"to {t}" for t in video_targets + audio_targets]
        elif ext in audio_exts:
            targets = [e.strip('.').upper() for e in audio_exts if e != ext]
            options = [f"to {t}" for t in targets]
        else:
            options = ["Not Supported"]

        self.format_menu.configure(values=options)
        self.format_menu.set(options[0])

    def start_conversion_thread(self):
        threading.Thread(target=self.convert_file, daemon=True).start()

    def convert_file(self):
        selected_option = self.format_menu.get()
        if not self.file_path or selected_option == "Not Supported":
            return

        target_fmt = selected_option.replace("to ", "").strip().lower()
        base_name, src_ext = os.path.splitext(self.file_path)
        output_path = f"{base_name}_converted.{target_fmt}"

        image_exts = ['.png', '.jpg', '.jpeg', '.webp', '.bmp', '.gif', '.ico']
        audio_exts = ['mp3', 'wav', 'flac', 'aac', 'm4a']

        self.after(0, lambda: self.set_ui_state("disabled"))

        try:
            if src_ext.lower() in image_exts:
                with Image.open(self.file_path) as img:
                    if target_fmt in ['jpg', 'jpeg'] and img.mode in ('RGBA', 'LA'):
                        img = img.convert('RGB')
                    
                    # حفظ بصيغة ICO مع تضمين الأحجام القياسية للأيقونة
                    if target_fmt == 'ico':
                        icon_sizes = [(16, 16), (32, 32), (48, 48), (64, 64), (128, 128), (256, 256)]
                        img.save(output_path, format='ICO', sizes=icon_sizes)
                    else:
                        img.save(output_path)

            else:
                ffmpeg_bin = get_ffmpeg_path()
                if not ffmpeg_bin:
                    raise Exception("FFmpeg missing! Please run 'pip install imageio-ffmpeg'")

                if target_fmt in audio_exts:
                    attempts = [[ffmpeg_bin, "-y", "-hide_banner", "-loglevel", "error", "-i", self.file_path, "-vn", output_path]]
                else:
                    attempts = build_video_attempts(ffmpeg_bin, self.file_path, output_path, target_fmt)
                run_attempts(attempts, output_path)

            self.after(0, lambda: self.on_conversion_success(output_path))

        except Exception as e:
            err_text = str(e)
            log_path = save_error_log(err_text)
            msg = short_error(err_text)
            if log_path:
                msg += "\n(full log: converter_last_error.log)"
            self.after(0, lambda m=msg: self.on_conversion_error(m))

        finally:
            self.after(0, lambda: self.set_ui_state("normal"))

    def set_ui_state(self, state):
        self.btn_select.configure(state=state)
        self.format_menu.configure(state=state)
        self.btn_convert.configure(state=state)
        if state == "disabled":
            self.hide_inline_alert()
            self.progress.set(0.3)
            self.lbl_status.configure(text="Converting...", text_color="#FFFFFF")

    def on_conversion_success(self, output_path):
        self.progress.set(1.0)
        self.lbl_status.configure(text="Completed!", text_color=self.ACCENT_GREEN)
        self.show_inline_alert("Success", f"File saved:\n{output_path}", is_success=True)

    def on_conversion_error(self, err_msg):
        self.progress.set(0)
        self.lbl_status.configure(text="Error occurred", text_color="#FF8888")
        self.show_inline_alert("Error", err_msg, is_success=False)

    def show_inline_alert(self, title, message, is_success=True):
        accent = self.ACCENT_GREEN if is_success else "#FF6B6B"
        self.lbl_alert_title.configure(text=f"✔ {title}" if is_success else f"✖ {title}", text_color=accent)
        self.lbl_alert_msg.configure(text=message)
        self.btn_alert_ok.configure(fg_color=accent)

        self.inline_alert_frame.pack(pady=(10, 5), padx=20, fill="x")
        threading.Thread(target=self.play_chime, daemon=True).start()

    def hide_inline_alert(self):
        self.inline_alert_frame.pack_forget()

    def play_chime(self):
        if winsound:
            try:
                winsound.Beep(523, 80)
                winsound.Beep(659, 80)
                winsound.Beep(784, 120)
            except Exception:
                pass


