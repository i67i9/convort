def get_ffmpeg_path():
    """البحث عن مسار ffmpeg تلقائياً"""
    sys_ffmpeg = shutil.which("ffmpeg")
    if sys_ffmpeg:
        return sys_ffmpeg

    local_exe = os.path.join(os.getcwd(), "ffmpeg.exe")
    if os.path.exists(local_exe):
        return local_exe

    try:
        import imageio_ffmpeg
        return imageio_ffmpeg.get_ffmpeg_exe()
    except Exception:
        return None


def lerp_color(c1, c2, t):
    """يمزج بين لونين (hex) حسب t من 0 إلى 1 - نستخدمه لتخفيف لون الموجة تدريجياً"""
    t = max(0.0, min(1.0, t))
    a = [int(c1[i:i + 2], 16) for i in (1, 3, 5)]
    b = [int(c2[i:i + 2], 16) for i in (1, 3, 5)]
    return "#%02x%02x%02x" % tuple(int(a[i] + (b[i] - a[i]) * t) for i in range(3))


def short_error(text, max_lines=2, max_len=100):
    """آخر أسطر الخطأ من ffmpeg (السبب الحقيقي دايماً يكون في النهاية)"""
    lines = [l.strip() for l in str(text).splitlines() if l.strip()]
    tail = lines[-max_lines:] if lines else ["Unknown error"]
    return "\n".join(l if len(l) <= max_len else l[:max_len - 3] + "..." for l in tail)


def save_error_log(text):
    """يحفظ الخطأ الكامل في ملف جنب السكربت عشان تقدر تقراه"""
    try:
        log_path = os.path.join(os.path.dirname(os.path.abspath(__file__)), "converter_last_error.log")
        with open(log_path, "w", encoding="utf-8") as f:
            f.write(str(text))
        return log_path
    except Exception:
        return None


def build_video_attempts(ffmpeg_bin, src, out, fmt):
    """قائمة محاولات التحويل بالترتيب، كل صيغة لها الكودك المناسب لها"""
    base = [ffmpeg_bin, "-y", "-hide_banner", "-loglevel", "error", "-i", src]
    if fmt == "webm":
        return [
            base + ["-c:v", "libvpx-vp9", "-b:v", "0", "-crf", "32",
                    "-deadline", "good", "-cpu-used", "4", "-row-mt", "1",
                    "-c:a", "libopus", out],
            base + ["-c:v", "libvpx", "-b:v", "5M", "-c:a", "libvorbis", out],
        ]
    if fmt == "avi":
        return [
            base + ["-c", "copy", out],
            base + ["-c:v", "mpeg4", "-q:v", "3", "-c:a", "libmp3lame", out],
        ]
    return [
        base + ["-c", "copy", out],
        base + ["-c:v", "libx264", "-pix_fmt", "yuv420p", "-c:a", "aac", out],
    ]


def run_attempts(attempts, output_path=None):
    """يجرب المحاولات واحدة واحدة، ولو كلها فشلت يرمي كل الأخطاء"""
    errors = []
    flags = 0
    if os.name == "nt":
        flags = subprocess.BELOW_NORMAL_PRIORITY_CLASS | subprocess.CREATE_NO_WINDOW
    for cmd in attempts:
        res = subprocess.run(cmd, capture_output=True, text=True,
                             encoding="utf-8", errors="replace",
                             stdin=subprocess.DEVNULL, creationflags=flags)
        if res.returncode == 0:
            return
        errors.append(res.stderr)
    if output_path and os.path.exists(output_path):
        try:
            os.remove(output_path)
        except OSError:
            pass
    raise Exception("\n\n----- next attempt -----\n\n".join(errors) or "ffmpeg failed")


def rr_points(x1, y1, x2, y2, r):
    """نقاط مستطيل بزوايا دائرية"""
    r = max(0, min(r, (x2 - x1) / 2, (y2 - y1) / 2))
    return [x1 + r, y1, x2 - r, y1, x2, y1, x2, y1 + r, x2, y2 - r, x2, y2,
            x2 - r, y2, x1 + r, y2, x1, y2, x1, y2 - r, x1, y1 + r, x1, y1]


class AnimatedOptionMenu(ctk.CTkOptionMenu):
    KEY = "#ff00ff"
    OPEN_TIME = 0.18
    CLOSE_TIME = 0.12

    _ap_popup = None
    _ap_canvas = None
    _ap_job = None
    _ap_state = "closed"
    _ap_progress = 0.0
    _ap_hover = -1
    _ap_texts = ()

    def __init__(self, master, popup_fg="#FFF5E4", popup_hover="#FFE3C8",
                 popup_text="#5C1313", popup_font_size=14, popup_radius=12, **kwargs):
        super().__init__(master, **kwargs)
        self._ap_fg = popup_fg
        self._ap_hover_c = popup_hover
        self._ap_text = popup_text
        self._ap_font_size = popup_font_size
        self._ap_radius = popup_radius
        self._ap_values = []
        self._ap_last = 0.0
        self._ap_root_geo = None
        root = self.winfo_toplevel()
        root.bind("<Button-1>", self._ap_on_root_click, add="+")
        root.bind("<Configure>", self._ap_on_root_configure, add="+")

    def _open_dropdown_menu(self):
        try:
            if self._ap_state in ("opening", "open"):
                self._ap_close()
            else:
                self._ap_open()
        except Exception as e:
            print("Animated dropdown failed, using default menu:", e)
            self._ap_kill()
            try:
                super()._open_dropdown_menu()
            except Exception:
                pass

    def configure(self, *args, **kwargs):
        if "values" in kwargs or kwargs.get("state") == "disabled":
            self._ap_kill()
        super().configure(*args, **kwargs)

    def destroy(self):
        self._ap_kill()
        super().destroy()

    def _ap_open(self):
        try:
            values = list(self.cget("values"))
        except Exception:
            values = list(getattr(self, "_values", []))
        if not values:
            return

        if self._ap_popup is not None and self._ap_state == "closing":
            self._ap_state = "opening"
            self._ap_last = time.perf_counter()
            self._ap_tick()
            return

        self._ap_kill()

        scale = max(1.0, self.winfo_fpixels("1i") / 96.0)
        self._ap_scale = scale
        self._ap_values = values
        self._ap_item_h = int(round(30 * scale))
        self._ap_pad = int(round(6 * scale))
        self._ap_w = max(self.winfo_width(), 60)
        self._ap_full_h = len(values) * self._ap_item_h + 2 * self._ap_pad
        x = self.winfo_rootx()
        y = self.winfo_rooty() + self.winfo_height() + int(round(3 * scale))

        top = tk.Toplevel(self)
        top.withdraw()
        top.overrideredirect(True)
        top.transient(self.winfo_toplevel())
        top.configure(bg=self.KEY)
        top.attributes("-transparentcolor", self.KEY)
        top.geometry(f"{self._ap_w}x{self._ap_full_h}+{x}+{y}")

        cv = tk.Canvas(top, width=self._ap_w, height=self._ap_full_h,
                       bg=self.KEY, highlightthickness=0, bd=0, cursor="hand2")
        cv.pack()

        self._ap_bg = cv.create_polygon(rr_points(0, 0, self._ap_w, 2, 1), smooth=True,
                                        fill=self._ap_fg, outline="")
        self._ap_hl = cv.create_polygon(rr_points(0, 0, 2, 2, 1), smooth=True,
                                        fill=self._ap_hover_c, outline="", state="hidden")
        font = (FONT_FAMILY, -int(round(self._ap_font_size * scale)))
        px = int(round(16 * scale))
        self._ap_texts = []
        for i, v in enumerate(values):
            cy = self._ap_pad + i * self._ap_item_h + self._ap_item_h // 2
            self._ap_texts.append(cv.create_text(
                px, cy, text=v, anchor="w", fill=self._ap_fg, font=font, state="hidden"))

        cv.bind("<Motion>", self._ap_on_motion)
        cv.bind("<Leave>", self._ap_on_leave)
        cv.bind("<Button-1>", self._ap_on_click)

        self._ap_popup = top
        self._ap_canvas = cv
        self._ap_state = "opening"
        self._ap_progress = 0.0
        self._ap_hover = -1
        root = self.winfo_toplevel()
        self._ap_root_geo = (root.winfo_rootx(), root.winfo_rooty(),
                             root.winfo_width(), root.winfo_height())
        self._ap_draw()
        top.deiconify()
        top.lift()
        self._ap_last = time.perf_counter()
        self._ap_job = self.after(8, self._ap_tick)

    def _ap_close(self):
        if self._ap_popup is None or self._ap_state in ("closed", "closing"):
            return
        self._ap_state = "closing"
        self._ap_hover = -1
        self._ap_last = time.perf_counter()
        self._ap_tick()

    def _ap_kill(self):
        if self._ap_job is not None:
            try:
                self.after_cancel(self._ap_job)
            except Exception:
                pass
            self._ap_job = None
        if self._ap_popup is not None:
            try:
                self._ap_popup.destroy()
            except Exception:
                pass
        self._ap_popup = None
        self._ap_canvas = None
        self._ap_state = "closed"
        self._ap_progress = 0.0
        self._ap_hover = -1
        self._ap_texts = ()

    def _ap_tick(self):
        if self._ap_job is not None:
            try:
                self.after_cancel(self._ap_job)
            except Exception:
                pass
            self._ap_job = None
        if self._ap_popup is None:
            return
        now = time.perf_counter()
        dt = now - self._ap_last
        self._ap_last = now
        if self._ap_state == "opening":
            self._ap_progress = min(1.0, self._ap_progress + dt / self.OPEN_TIME)
            if self._ap_progress >= 1.0:
                self._ap_state = "open"
        elif self._ap_state == "closing":
            self._ap_progress = max(0.0, self._ap_progress - dt / self.CLOSE_TIME)
            if self._ap_progress <= 0.0:
                self._ap_kill()
                return
        self._ap_draw()
        if self._ap_state in ("opening", "closing"):
            self._ap_job = self.after(8, self._ap_tick)

    def _ap_draw(self):
        cv = self._ap_canvas
        if cv is None:
            return
        s = self._ap_scale
        ih = self._ap_item_h
        w = self._ap_w
        ease = 1 - (1 - self._ap_progress) ** 3
        h = max(2.0, self._ap_full_h * ease)
        cv.coords(self._ap_bg, *rr_points(0, 0, w, h, self._ap_radius * s))

        for i, tid in enumerate(self._ap_texts):
            zone = self._ap_pad + (i + 0.5) * ih + 0.4 * ih
            f = (h - zone) / (0.3 * ih)
            if f <= 0:
                cv.itemconfigure(tid, state="hidden")
            else:
                cv.itemconfigure(tid, state="normal",
                                 fill=lerp_color(self._ap_fg, self._ap_text, min(1.0, f)))

        if self._ap_state == "open" and 0 <= self._ap_hover < len(self._ap_values):
            y1 = self._ap_pad + self._ap_hover * ih
            inset = 5 * s
            cv.coords(self._ap_hl, *rr_points(inset, y1, w - inset, y1 + ih, 8 * s))
            cv.itemconfigure(self._ap_hl, state="normal")
        else:
            cv.itemconfigure(self._ap_hl, state="hidden")

    def _ap_index_at(self, y):
        idx = int((y - self._ap_pad) // self._ap_item_h)
        return idx if 0 <= idx < len(self._ap_values) else -1

    def _ap_on_motion(self, event):
        if self._ap_state != "open":
            return
        idx = self._ap_index_at(event.y)
        if idx != self._ap_hover:
            self._ap_hover = idx
            self._ap_draw()

    def _ap_on_leave(self, event):
        if self._ap_hover != -1:
            self._ap_hover = -1
            if self._ap_state == "open":
                self._ap_draw()

    def _ap_on_click(self, event):
        if self._ap_state != "open":
            return
        idx = self._ap_index_at(event.y)
        if idx < 0:
            return
        value = self._ap_values[idx]
        self.set(value)
        cmd = getattr(self, "_command", None)
        if callable(cmd):
            try:
                cmd(value)
            except Exception:
                pass
        self._ap_close()

    def _ap_on_root_click(self, event):
        if self._ap_state not in ("opening", "open"):
            return
        fx, fy = self.winfo_rootx(), self.winfo_rooty()
        if fx <= event.x_root <= fx + self.winfo_width() and fy <= event.y_root <= fy + self.winfo_height():
            return
        self._ap_close()

    def _ap_on_root_configure(self, event):
        if self._ap_state == "closed":
            return
        root = self.winfo_toplevel()
        if event.widget is not root:
            return
        geo = (root.winfo_rootx(), root.winfo_rooty(), root.winfo_width(), root.winfo_height())
        if geo != self._ap_root_geo:
            self._ap_kill()


